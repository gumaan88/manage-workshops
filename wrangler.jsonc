{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gumaan-workshops",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/join/*", "/certificates/verify/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gumaan-workshops-prod",
      "database_id": "placeholder-id-local-or-remote",
      "migrations_dir": "database"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gumaan-workshops-files-prod"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "APP_BASE_URL": "http://localhost:5173"
  }
}
