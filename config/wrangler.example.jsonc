{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gumaan-workshops",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/join/*", "/certificates/verify/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gumaan-workshops-prod",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gumaan-workshops-files-prod"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "15 2 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "workshops.gumaan.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_BASE_URL": "https://workshops.gumaan.app",
    "EMAIL_PROVIDER": "disabled"
  }
}
