# Local development only. Copy to .dev.vars and never commit real values.
APP_ENV=local
APP_BASE_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=Workshops <no-reply@example.test>
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-before-running-seed
SEED_FACILITATOR_EMAIL=facilitator@example.test
SEED_FACILITATOR_PASSWORD=replace-before-running-seed
SEED_PARTICIPANT_EMAIL=participant@example.test
SEED_PARTICIPANT_PASSWORD=replace-before-running-seed
AUDIT_IP_SALT=replace-with-random-secret
